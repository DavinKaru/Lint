  "redirectWrappers": [
    {
      "sites": [
        "google.*"
      ],
      "paths": [
        "/url"
      ],
      "params": [
        "q",
        "url"
      ],
      "source": "Google redirects (Gmail, Docs, Search)",
      "notes": "Gmail and Google Docs wrap every link as google.com/url?q=<link>; search results use ?url=."
    },
    {
      "sites": [
        "safelinks.protection.outlook.com"
      ],
      "paths": [
        "/*"
      ],
      "params": [
        "url"
      ],
      "source": "Outlook Safe Links",
      "notes": "Regional hosts like nam12.safelinks.protection.outlook.com, sometimes with an /ap/... path."
    },
    {
      "sites": [
        "l.facebook.com",
        "lm.facebook.com",
        "l.messenger.com"
      ],
      "paths": [
        "/l.php"
      ],
      "params": [
        "u"
      ],
      "source": "Facebook and Messenger link redirects"
    },
    {
      "sites": [
        "l.instagram.com"
      ],
      "paths": [
        "/"
      ],
      "params": [
        "u"
      ],
      "source": "Instagram link redirects"
    },
    {
      "sites": [
        "l.threads.net",
        "l.threads.com"
      ],
      "paths": [
        "/"
      ],
      "params": [
        "u"
      ],
      "source": "Threads link redirects"
