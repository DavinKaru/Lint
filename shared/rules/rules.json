{
  "_about": "The single source of truth for Lint's cleaning rules on every platform. Edit this file, then run `python3 shared/rules/generate.py` to regenerate the Kotlin and Swift code (CI fails if they're out of date). See shared/rules/README.md.",
  "version": 1,
  "trackingPrefixes": [
    {
      "prefixes": [
        "utm_"
      ],
      "source": "Google Analytics campaign tags (used everywhere)"
    },
    {
      "prefixes": [
        "mtm_"
      ],
      "source": "Matomo campaign tags"
    },
    {
      "prefixes": [
        "cp_smn_"
      ],
      "source": "Secret Media Network (Secret Melbourne, Secret London, ...)",
      "notes": "Campaign tags it adds to partner links, e.g. Fever tickets (cp_smn_source, cp_smn_content, cp_smn_term). Distinctive enough to strip on every site, like utm_."
    }
  ],
  "trackingParams": [
    {
      "params": [
        "fbclid",
        "gclid",
        "gclsrc",
        "dclid",
        "gbraid",
        "wbraid",
        "msclkid",
        "igshid",
        "igsh",
        "twclid",
        "ttclid",
        "yclid"
      ],
      "source": "Ad and social click IDs"
    },
    {
      "params": [
        "vero_id",
        "vero_conv"
      ],
      "source": "Vero"
    },
    {
      "params": [
        "mc_cid",
        "mc_eid"
      ],
      "source": "Mailchimp"
    },
    {
      "params": [
        "mkt_tok"
      ],
      "source": "Marketo"
    },
    {
      "params": [
        "_hsenc",
        "_hsmi",
        "__hsfp",
        "__hssc",
        "__hstc"
      ],
      "source": "HubSpot"
    },
    {
      "params": [
        "ref",
        "ref_src"
      ],
      "source": "Generic referral",
      "notes": "Generic names, under review in #15."
    },
    {
      "params": [
        "epik"
      ],
      "source": "Pinterest"
    },
    {
      "params": [
        "aqs",
        "cd",
        "ei",
        "iflsig",
        "pcampaignid",
        "rlz",
        "srsltid",
        "sxsrf",
        "uact",
        "ved",
        "_ga",
        "_gl"
      ],
      "source": "Google (Ads, Analytics, Search, Shopping)",
      "notes": "cd and ei are generic names, under review in #15."
    },
    {
      "params": [
        "comment_tracking",
        "eav",
        "mibextid",
        "__tn__"
      ],
      "source": "Meta / Facebook",
      "notes": "eid is Facebook-only, see siteParams."
    },
    {
      "params": [
        "ScCid"
      ],
      "source": "Snapchat"
    },
    {
      "params": [
        "correlation_id",
        "rdt",
        "ref_campaign",
        "ref_source",
        "share_id"
      ],
      "source": "Reddit",
      "notes": "share_id is a generic name, under review in #15."
    },
    {
      "params": [
        "refId",
        "trackingId",
        "trk"
      ],
      "source": "LinkedIn",
      "notes": "Generic names, under review in #15."
    },
    {
      "params": [
        "ascsubtag",
        "camp",
        "creative",
        "dchild",
        "qid",
        "refRID",
        "smid",
        "spIA",
        "srs"
      ],
      "source": "Amazon",
      "notes": "camp, creative, qid, smid and srs are generic names, under review in #15."
    },
    {
      "params": [
        "__twitter_impression"
      ],
      "source": "Twitter / X"
    },
    {
      "params": [
        "pk_campaign",
        "pk_kwd",
        "pk_keyword",
        "pk_medium",
        "pk_source",
        "pk_content",
        "pk_cid",
        "piwik_campaign",
        "piwik_kwd"
      ],
      "source": "Matomo / Piwik (legacy)",
      "notes": "Exact names only: a blanket pk_* or piwik_* prefix would hit ordinary params like ?pk_id=42."
    }
  ],
  "siteParams": [
    {
      "sites": [
        "youtube.com",
        "youtu.be"
      ],
      "params": [
        "feature",
        "si",
        "pp"
      ],
      "source": "YouTube",
      "notes": "feature marks a video reached via a youtu.be short link; si is the per-share token identifying who shared it. pp encodes the search that led to the video."
    },
    {
      "sites": [
        "spotify.com"
      ],
      "params": [
        "si"
      ],
      "source": "Spotify",
      "notes": "si is the per-share token identifying who shared it."
    },
    {
      "sites": [
        "facebook.com"
      ],
      "params": [
        "eid"
      ],
      "source": "Meta / Facebook",
      "notes": "eid is a Facebook tracking param, but Google Calendar uses ?eid= to identify an event (#2), so it's only stripped on Facebook."
    },
    {
      "sites": [
        "eventbrite.*"
      ],
      "params": [
        "aff",
        "sg"
      ],
      "source": "Eventbrite",
      "notes": "aff records how a link was shared (e.g. ebdsshandroid, ebdsshsms); sg is a long per-share token. Eventbrite uses a domain per country, hence the wildcard."
    },
    {
      "sites": [
        "feverup.com"
      ],
      "params": [
        "suid"
      ],
      "source": "Fever",
      "notes": "suid looks like a per-user/session ID on shared event links."
    },
    {
      "sites": [
        "tiktok.com"
      ],
      "params": [
        "is_from_webapp",
        "sender_device",
        "web_id",
        "share_app_id",
        "share_link_id",
        "share_item_id",
        "u_code",
        "_r",
        "_t"
      ],
      "source": "TikTok",
      "notes": "Appended once a vm.tiktok.com/vt.tiktok.com share link resolves, identifying the sharer's device/session and how the link was copied."
    },
    {
      "sites": [
        "x.com",
        "twitter.com"
      ],
      "params": [
        "s",
        "t"
      ],
      "source": "X / Twitter",
      "notes": "s says which share option was used (e.g. s=20, s=46); t is a per-share token identifying who shared it."
    },
    {
      "sites": [
        "google.*"
      ],
      "params": [
        "g_st",
        "g_ep"
      ],
      "source": "Google Maps",
      "notes": "Added to links resolved from maps.app.goo.gl: g_st is the share type and g_ep encodes the share context. entry= is left alone."
    },
    {
      "sites": [
        "amazon.*"
      ],
      "params": [
        "crid",
        "dib",
        "dib_tag",
        "keywords",
        "sprefix",
        "sr",
        "pd_rd_w",
        "pd_rd_r",
        "pd_rd_wg",
        "pd_rd_i",
        "pf_rd_p",
        "pf_rd_r",
        "pf_rd_s",
        "pf_rd_t",
        "pf_rd_i",
        "pf_rd_m",
        "content-id",
        "linkCode",
        "linkId",
        "creativeASIN",
        "social_share",
        "_encoding",
        "ref_"
      ],
      "source": "Amazon (full links, every country domain)",
      "notes": "Search and recommendation context on product links (keywords and sprefix carry what you searched for). Variant selectors th and psc are kept, and so is the tag affiliate ID (see the affiliate-ID decision issue)."
    },
    {
      "sites": [
        "music.apple.com",
        "podcasts.apple.com",
        "apps.apple.com",
        "itunes.apple.com"
      ],
      "params": [
        "uo",
        "ct"
      ],
      "source": "Apple Music, Podcasts and App Store",
      "notes": "uo and ct are campaign/origin tracking. i= (the track or episode), mt= and app= are kept; the at= affiliate token is kept too."
    },
    {
      "sites": [
        "substack.com"
      ],
      "params": [
        "r",
        "showWelcomeOnShare"
      ],
      "source": "Substack",
      "notes": "r is the sharer's referral ID. triedRedirect is left alone because custom-domain redirects use it."
    },
    {
      "sites": [
        "pinterest.*"
      ],
      "params": [
        "invite_code",
        "sender",
        "sfo",
        "mweb_unauth_id"
      ],
      "source": "Pinterest",
      "notes": "Added to pins opened from pin.it share links: invite_code and sender identify who shared it."
    },
    {
      "sites": [
        "linkedin.com"
      ],
      "params": [
        "rcm",
        "lipi",
        "midToken",
        "midSig",
        "trkEmail"
      ],
      "source": "LinkedIn",
      "notes": "rcm identifies the member who shared a post; lipi, midToken, midSig and trkEmail are page and email tracking. otpToken (email sign-in) is deliberately not listed."
    },
    {
      "sites": [
        "threads.net",
        "threads.com"
      ],
      "params": [
        "xmt",
        "slof"
      ],
      "source": "Threads",
      "notes": "Per-share tracking tokens on post links."
    },
    {
      "sites": [
        "tumblr.com"
      ],
      "params": [
        "source"
      ],
      "source": "Tumblr",
      "notes": "source=share marks how a post was shared."
    },
    {
      "sites": [
        "quora.com"
      ],
      "params": [
        "ch",
        "oid",
        "share",
        "srid",
        "target_type"
      ],
      "source": "Quora",
      "notes": "Share-sheet tracking on answer links."
    },
    {
      "sites": [
        "soundcloud.com"
      ],
      "params": [
        "si"
      ],
      "source": "SoundCloud",
      "notes": "si is the per-share token, as on Spotify and YouTube."
    },
    {
      "sites": [
        "twitch.tv"
      ],
      "params": [
        "tt_medium",
        "tt_content",
        "tt_campaign"
      ],
      "source": "Twitch",
      "notes": "Share tracking on clip and channel links."
    },
    {
      "sites": [
        "vimeo.com"
      ],
      "params": [
        "share"
      ],
      "source": "Vimeo",
      "notes": "share=copy marks how the link was copied. Private-video hashes (in the path or h=) are kept."
    },
    {
      "sites": [
        "netflix.com"
      ],
      "params": [
        "s",
        "trkid",
        "trg"
      ],
      "source": "Netflix",
      "notes": "Share source and tracking IDs on title links. clip= is kept."
    },
    {
      "sites": [
        "tidal.com"
      ],
      "params": [
        "u"
      ],
      "source": "Tidal",
      "notes": "The bare ?u Tidal's share sheet appends."
    },
    {
      "sites": [
        "shazam.com"
      ],
      "params": [
        "referrer"
      ],
      "source": "Shazam",
      "notes": "referrer=share on song links."
    },
    {
      "sites": [
        "docs.google.com",
        "drive.google.com"
      ],
      "params": [
        "usp"
      ],
      "source": "Google Docs and Drive",
      "notes": "usp=sharing / drive_link / share_link only records which button made the link. resourcekey and everything else is kept."
    },
    {
      "sites": [
        "notion.so",
        "notion.site"
      ],
      "params": [
        "pvs"
      ],
      "source": "Notion",
      "notes": "pvs is the page-view source."
    },
    {
      "sites": [
        "figma.com"
      ],
      "params": [
        "t"
      ],
      "source": "Figma",
      "notes": "t is a per-share tracking token. node-id and everything else is kept."
    },
    {
      "sites": [
        "canva.com"
      ],
      "params": [
        "utlId"
      ],
      "source": "Canva",
      "notes": "utlId is a per-share link ID (alongside utm_*). The view token in the path is kept."
    }
  ],
  "shortLinkHosts": [
    {
      "hosts": [
        "amzn.to",
        "amzn.asia",
        "a.co"
      ],
      "provider": "Amazon",
      "notes": "Amazon blocks plain HTTP clients (#11); kept because it fails safe to the unresolved link."
    },
    {
      "hosts": [
        "youtu.be"
      ],
      "provider": "YouTube"
    },
    {
      "hosts": [
        "t.co"
      ],
      "provider": "Twitter / X"
    },
    {
      "hosts": [
        "fb.watch"
      ],
      "provider": "Facebook"
    },
    {
      "hosts": [
        "spoti.fi"
      ],
      "provider": "Spotify"
    },
    {
      "hosts": [
        "vm.tiktok.com",
        "vt.tiktok.com"
      ],
      "provider": "TikTok"
    },
    {
      "hosts": [
        "maps.app.goo.gl"
      ],
      "provider": "Google Maps",
      "notes": "Google Maps share links."
    },
    {
      "hosts": [
        "redd.it"
      ],
      "provider": "Reddit"
    },
    {
      "hosts": [
        "pin.it"
      ],
      "provider": "Pinterest"
    },
    {
      "hosts": [
        "lnkd.in"
      ],
      "provider": "LinkedIn"
    },
    {
      "hosts": [
        "fb.me"
      ],
      "provider": "Facebook"
    },
    {
      "hosts": [
        "on.soundcloud.com"
      ],
      "provider": "SoundCloud"
    }
  ],
  "neverStrip": [
    {
      "params": [
        "cid"
      ],
      "notes": "Google Maps uses ?cid= to identify a place (#2). Too generic to scope to one tracking site."
    },
    {
      "params": [
        "eid"
      ],
      "notes": "Google Calendar uses ?eid= to identify an event (#2). Only stripped on Facebook (siteParams)."
    }
  ],
  "redirectWrappers": [
    {
      "sites": [
        "google.*"
      ],
      "paths": [
        "/url"
      ],
      "params": [
        "q",
        "url"
      ],
      "source": "Google redirects (Gmail, Docs, Search)",
      "notes": "Gmail and Google Docs wrap every link as google.com/url?q=<link>; search results use ?url=."
    },
    {
      "sites": [
        "safelinks.protection.outlook.com"
      ],
      "paths": [
        "/*"
      ],
      "params": [
        "url"
      ],
      "source": "Outlook Safe Links",
      "notes": "Regional hosts like nam12.safelinks.protection.outlook.com, sometimes with an /ap/... path."
    },
    {
      "sites": [
        "l.facebook.com",
        "lm.facebook.com",
        "l.messenger.com"
      ],
      "paths": [
        "/l.php"
      ],
      "params": [
        "u"
      ],
      "source": "Facebook and Messenger link redirects"
    },
    {
      "sites": [
        "l.instagram.com"
      ],
      "paths": [
        "/"
      ],
      "params": [
        "u"
      ],
      "source": "Instagram link redirects"
    },
    {
      "sites": [
        "l.threads.net",
        "l.threads.com"
      ],
      "paths": [
        "/"
      ],
      "params": [
        "u"
      ],
      "source": "Threads link redirects"
    },
    {
      "sites": [
        "youtube.com"
      ],
      "paths": [
        "/redirect"
      ],
      "params": [
        "q"
      ],
      "source": "YouTube description and comment links"
    },
    {
      "sites": [
        "linkedin.com"
      ],
      "paths": [
        "/redir/redirect",
        "/safety/go"
      ],
      "params": [
        "url"
      ],
      "source": "LinkedIn link redirects"
    },
    {
      "sites": [
        "out.reddit.com"
      ],
      "paths": [
        "/*"
      ],
      "params": [
        "url"
      ],
      "source": "Reddit outbound links",
      "notes": "Path is the post ID, e.g. /t3_abc123."
    },
    {
      "sites": [
        "duckduckgo.com"
      ],
      "paths": [
        "/l/"
      ],
      "params": [
        "uddg"
      ],
      "source": "DuckDuckGo result redirects"
    },
    {
      "sites": [
        "slack-redir.net"
      ],
      "paths": [
        "/link"
      ],
      "params": [
        "url"
      ],
      "source": "Slack link redirects"
    },
    {
      "sites": [
        "steamcommunity.com"
      ],
      "paths": [
        "/linkfilter/"
      ],
      "params": [
        "u",
        "url"
      ],
      "source": "Steam link filter"
    },
    {
      "sites": [
        "vk.com"
      ],
      "paths": [
        "/away.php"
      ],
      "params": [
        "to"
      ],
      "source": "VK outbound links"
    },
    {
      "sites": [
        "t.umblr.com"
      ],
      "paths": [
        "/redirect"
      ],
      "params": [
        "z"
      ],
      "source": "Tumblr link redirects"
    }
  ],
  "pathWrappers": [
    {
      "sites": [
        "google.*"
      ],
      "prefix": "/amp/s/",
      "scheme": "https",
      "source": "Google AMP viewer",
      "notes": "google.com/amp/s/<host>/<path> shows another site's AMP page; the original is https://<host>/<path>."
    }
  ],
  "shortLinkPaths": [
    {
      "sites": [
        "reddit.com"
      ],
      "paths": [
        "/r/*/s/*"
      ],
      "provider": "Reddit",
      "notes": "App share links like reddit.com/r/<sub>/s/<code>; the full post link carries share_id and utm_*."
    },
    {
      "sites": [
        "facebook.com"
      ],
      "paths": [
        "/share/*",
        "/share/*/*"
      ],
      "provider": "Facebook",
      "notes": "Share links like facebook.com/share/p/<code>/ and /share/r/<code>/."
    }
  ]
}
