        "ref",
        "ref_src"
      ],
      "source": "Generic referral",
      "notes": "Generic names, under review in #15."
    },
    {
      "params": [
        "epik"
      ],
      "source": "Pinterest"
    },
    {
      "params": [
        "aqs",
        "cd",
        "ei",
        "iflsig",
        "pcampaignid",
        "rlz",
        "srsltid",
        "sxsrf",
        "uact",
        "ved",
        "_ga",
        "_gl"
      ],
      "source": "Google (Ads, Analytics, Search, Shopping)",
      "notes": "cd and ei are generic names, under review in #15."
    },
    {
      "params": [
        "comment_tracking",
        "eav",
        "mibextid",
        "__tn__"
      ],
      "source": "Meta / Facebook",
      "notes": "eid is Facebook-only, see siteParams."
    },
    {
      "params": [
        "ScCid"
      ],
      "source": "Snapchat"
    },
    {
      "params": [
        "correlation_id",
        "rdt",
        "ref_campaign",
        "ref_source",
        "share_id"
      ],
      "source": "Reddit",
      "notes": "share_id is a generic name, under review in #15."
    },
    {
      "params": [
        "refId",
        "trackingId",
        "trk"
      ],
      "source": "LinkedIn",
      "notes": "Generic names, under review in #15."
    },
    {
      "params": [
        "dchild",
        "qid",
        "refRID",
        "smid",
        "spIA",
        "srs"
      ],
      "source": "Amazon",
      "notes": "qid, smid and srs are generic names, under review in #15."
    },
    {
      "params": [
        "__twitter_impression"
      ],
      "source": "Twitter / X"
    },
    {
      "params": [
        "pk_campaign",
        "pk_kwd",
        "pk_keyword",
        "pk_medium",
        "pk_source",
        "pk_content",
        "pk_cid",
        "piwik_campaign",
        "piwik_kwd"
      ],
      "source": "Matomo / Piwik (legacy)",
      "notes": "Exact names only: a blanket pk_* or piwik_* prefix would hit ordinary params like ?pk_id=42."
    },
    {
      "params": [
        "xtor"
      ],
      "source": "AT Internet / Piano Analytics",
      "notes": "Campaign tag on many European news sites. Distinctive enough to strip everywhere."
    },
    {
      "params": [
        "_bhlid"
      ],
      "source": "Beehiiv",
      "notes": "Per-subscriber click ID on links in Beehiiv newsletters, which are often on custom domains, so it's stripped everywhere."
    }
  ],
  "siteParams": [
    {
      "sites": [
        "youtube.com",
        "youtu.be"
      ],
      "params": [
        "feature",
        "si",
        "pp"
      ],
      "source": "YouTube",
      "notes": "feature marks a video reached via a youtu.be short link; si is the per-share token identifying who shared it. pp encodes the search that led to the video."
    },
    {
      "sites": [
        "spotify.com"
      ],
      "params": [
        "si"
      ],
      "source": "Spotify",
      "notes": "si is the per-share token identifying who shared it."
    },
    {
      "sites": [
        "facebook.com"
      ],
      "params": [
        "eid",
        "referral_code",
        "referral_story_type",
        "tracking"
      ],
      "source": "Meta / Facebook (including Marketplace)",
      "notes": "eid is a Facebook tracking param, but Google Calendar uses ?eid= to identify an event (#2), so it's only stripped on Facebook. referral_code, referral_story_type and tracking are added to shared Marketplace listings."
    },
    {
      "sites": [
        "eventbrite.*"
      ],
      "params": [
        "aff",
        "sg"
      ],
      "source": "Eventbrite",
      "notes": "aff records how a link was shared (e.g. ebdsshandroid, ebdsshsms) and sg is a long per-share token, both added when you share. Eventbrite uses a domain per country, hence the wildcard."
    },
    {
      "sites": [
        "feverup.com"
      ],
      "params": [
        "suid"
      ],
      "source": "Fever",
      "notes": "suid looks like a per-user/session ID on shared event links."
    },
    {
      "sites": [
        "tiktok.com"
      ],
      "params": [
        "is_from_webapp",
        "sender_device",
        "web_id",
        "share_app_id",
        "share_link_id",
        "share_item_id",
        "u_code",
        "_r",
        "_t"
      ],
      "source": "TikTok",
      "notes": "Appended once a vm.tiktok.com/vt.tiktok.com share link resolves, identifying the sharer's device/session and how the link was copied."
    },
    {
      "sites": [
        "x.com",
        "twitter.com"
      ],
      "params": [
        "s",
        "t"
      ],
      "source": "X / Twitter",
      "notes": "s says which share option was used (e.g. s=20, s=46); t is a per-share token identifying who shared it."
    },
    {
      "sites": [
        "google.*"
      ],
      "params": [
        "g_st",
        "g_ep"
      ],
      "source": "Google Maps",
      "notes": "Added to links resolved from maps.app.goo.gl: g_st is the share type and g_ep encodes the share context. entry= is left alone."
    },
    {
      "sites": [
        "amazon.*"
      ],
      "params": [
        "crid",
        "dib",
        "dib_tag",
        "sprefix",
        "sr",
        "pd_rd_w",
        "pd_rd_r",
        "pd_rd_wg",
        "pd_rd_i",
        "pf_rd_p",
        "pf_rd_r",
        "pf_rd_s",
        "pf_rd_t",
        "pf_rd_i",
        "pf_rd_m",
        "content-id",
        "social_share",
        "_encoding",
        "ref_"
      ],
      "source": "Amazon (full links, every country domain)",
      "notes": "Search and recommendation context on product links (sprefix carries what you searched for). Variant selectors th and psc are kept. Affiliate link params (tag, linkCode, linkId, ascsubtag, creativeASIN, camp, creative) are kept, see affiliateParams. keywords is only stripped on product pages (below): older search links (amazon.com/s?keywords=...) use it as the query."
    },
    {
      "sites": [
        "amazon.*"
      ],
      "paths": [
        "/dp/*/**",
        "/*/dp/*/**",
        "/gp/product/*/**",
        "/gp/aw/d/*/**",
        "/-/*/dp/*/**",
        "/-/*/*/dp/*/**",
        "/-/*/gp/product/*/**",
        "/-/*/gp/aw/d/*/**"
      ],
      "params": [
        "keywords"
      ],
      "source": "Amazon product pages",
      "notes": "keywords on a product link is what you searched for to find it. Only stripped on product pages: on search links (/s?keywords=...) it is the query. /-/<lang>/ paths are the same pages in another language."
    },
    {
      "sites": [
        "music.apple.com",
        "podcasts.apple.com",
        "apps.apple.com",
        "itunes.apple.com"
      ],
      "params": [
        "uo",
        "ct"
      ],
      "source": "Apple Music, Podcasts and App Store",
      "notes": "uo and ct are origin and campaign tracking (the share sheet adds ct=share). i= (the track or episode), mt= and app= are kept, and so is the at= affiliate token (see affiliateParams)."
    },
    {
      "sites": [
        "substack.com"
      ],
      "params": [
        "r",
        "showWelcomeOnShare"
      ],
      "source": "Substack",
      "notes": "r is the referral ID of whoever shared the link, added when you share, so it identifies you and is removed (unlike affiliate IDs, see affiliateParams). triedRedirect is left alone because custom-domain redirects use it."
    },
    {
      "sites": [
        "pinterest.*"
      ],
      "params": [
        "sfo",
        "mweb_unauth_id"
      ],
      "source": "Pinterest",
      "notes": "Added to pins opened from pin.it share links. invite_code and sender are only stripped on pin pages (below): Pinterest also uses them for group-board and sign-up invites."
    },
    {
      "sites": [
        "pinterest.*"
      ],
      "paths": [
        "/pin/*/**"
      ],
      "params": [
        "invite_code",
        "sender"
      ],
      "source": "Pinterest pin pages",
      "notes": "Who shared the pin. Only stripped on /pin/<id>/ pages: on group-board and sign-up links they are the invite."
    },
    {
      "sites": [
        "linkedin.com"
      ],
      "params": [
        "rcm",
        "lipi",
        "midToken",
        "midSig",
        "trkEmail"
      ],
      "source": "LinkedIn",
      "notes": "rcm identifies the member who shared a post; lipi, midToken, midSig and trkEmail are page and email tracking. otpToken (email sign-in) is deliberately not listed."
    },
    {
      "sites": [
        "threads.net",
        "threads.com"
      ],
      "params": [
        "xmt",
        "slof"
      ],
      "source": "Threads",
      "notes": "Per-share tracking tokens on post links."
    },
    {
      "sites": [
        "quora.com"
      ],
      "params": [
        "ch",
        "oid",
        "target_type"
      ],
      "source": "Quora",
      "notes": "Share-sheet tracking on answer links. share and srid are kept: they let a logged-out recipient past the sign-in wall."
    },
    {
      "sites": [
        "soundcloud.com"
      ],
      "params": [
        "si"
      ],
      "source": "SoundCloud",
      "notes": "si is the per-share token, as on Spotify and YouTube."
    },
    {
      "sites": [
        "twitch.tv"
      ],
      "params": [
        "tt_medium",
        "tt_content",
        "tt_campaign"
      ],
      "source": "Twitch",
      "notes": "Share tracking on clip and channel links."
    },
    {
      "sites": [
        "vimeo.com"
      ],
      "params": [
        "share"
      ],
      "source": "Vimeo",
      "notes": "share=copy marks how the link was copied. Private-video hashes (in the path or h=) are kept."
    },
    {
      "sites": [
        "netflix.com"
      ],
      "params": [
        "s",
        "trkid",
        "trg"
      ],
      "source": "Netflix",
      "notes": "Share source and tracking IDs on title links. clip= is kept."
    },
    {
      "sites": [
        "tidal.com"
      ],
      "params": [
        "u"
      ],
      "source": "Tidal",
      "notes": "The bare ?u Tidal's share sheet appends."
    },
    {
      "sites": [
        "shazam.com"
      ],
      "params": [
        "referrer"
      ],
      "source": "Shazam",
      "notes": "referrer=share on song links."
    },
    {
      "sites": [
        "docs.google.com",
        "drive.google.com"
      ],
      "params": [
        "usp"
      ],
      "source": "Google Docs and Drive",
      "notes": "usp=sharing / drive_link / share_link only records which button made the link. resourcekey and everything else is kept."
    },
    {
      "sites": [
        "notion.so",
        "notion.site"
      ],
      "params": [
        "pvs"
      ],
      "source": "Notion",
      "notes": "pvs is the page-view source."
    },
    {
      "sites": [
        "figma.com"
      ],
      "params": [
        "t"
      ],
      "source": "Figma",
      "notes": "t is a per-share tracking token. node-id and everything else is kept."
    },
    {
      "sites": [
        "canva.com"
      ],
      "params": [
        "utlId"
      ],
      "source": "Canva",
      "notes": "utlId is a per-share link ID (alongside utm_*). The view token in the path is kept."
    },
    {
      "sites": [
        "ebay.*"
      ],
      "params": [
        "_trkparms",
        "_trksid",
        "_from",
        "hash",
        "ssspo",
        "sssrc",
        "ssuid",
        "widget_ver",
        "amdata"
      ],
      "source": "eBay",
      "notes": "Search and share-sheet (sss*) tracking. var= picks the variation and epid= the product, so both are kept, and so are the eBay Partner Network params (see affiliateParams). eBay's own app shares carry mkcid, mkrid and mkevt too; they're kept as well, since they can't be told apart from a partner's."
    },
    {
      "sites": [
        "aliexpress.*"
      ],
      "params": [
        "spm",
        "scm",
        "scm_id",
        "scm-url",
        "pvid",
        "algo_pvid",
        "algo_exp_id",
        "terminal_id",
        "afSmartRedirect",
        "gatewayAdapt",
        "sourceType",
        "srcSns",
        "businessType",
        "social_params",
        "tt",
        "utparam",
        "gps-id",
        "curPageLogUid",
        "bizType",
        "mp",
        "_randl_shipto"
      ],
      "source": "AliExpress",
      "notes": "Page, algorithm and share tracking. pdp_ext_f and pdp_npi are kept: they can carry the chosen SKU and price. The aff_* and sk affiliate params are kept (see affiliateParams)."
    },
    {
      "sites": [
        "etsy.com"
      ],
      "params": [
        "click_key",
        "click_sum",
        "ga_order",
        "ga_search_type",
        "ga_view_type",
        "ga_search_query",
        "organic_search_click",
        "plkey",
        "sts",
        "frs",
        "pro",
        "sr_prefetch",
        "pf_from",
        "logging_key",
        "content_source",
        "share_time"
      ],
      "source": "Etsy",
      "notes": "Search and share tracking on listing links. variation0/variation1 pick the options and are kept."
    },
    {
      "sites": [
        "shein.*"
      ],
      "params": [
        "src_identifier",
        "src_module",
        "src_tab_page_id",
        "scici",
        "ici",
        "share_from",
        "url_from",
        "onelink"
      ],
      "source": "Shein",
      "notes": "Share and page-source tracking. mallCode picks the warehouse and is kept."
    },
    {
      "sites": [
        "temu.com"
      ],
      "params": [
        "refer_page_name",
        "refer_page_id",
        "refer_page_sn",
        "_x_sessn_id",
        "share_uin",
        "_x_vst_scene"
      ],
      "source": "Temu",
      "notes": "Session and sharer (share_uin) tracking. goods_id, sku_id and _x_ns_sku_id pick the product and are kept, and so are the _x_ads_* params, which credit Temu affiliates (see affiliateParams)."
    },
    {
      "sites": [
        "walmart.com"
      ],
      "params": [
        "athbdg",
        "athcpid",
        "athpgid",
        "athznid",
        "athieid",
        "athstid",
        "athguid",
        "athwpid",
        "athena",
        "athancid"
      ],
      "source": "Walmart",
      "notes": "ath* are recommendation-carousel tracking. classType and selected are kept, and so are the affiliate params (see affiliateParams)."
    },
    {
      "sites": [
        "vinted.*"
      ],
      "params": [
        "referrer",
        "homepage_session_id"
      ],
      "source": "Vinted",
      "notes": "Where the item was opened from. referrer is generic, so it's only stripped here."
    },
    {
      "sites": [
        "bbc.co.uk",
        "bbc.com"
      ],
      "params": [
        "at_medium",
        "at_campaign",
        "at_campaign_type",
        "at_link_id",
        "at_link_origin",
        "at_link_type",
        "at_format",
        "at_ptr_name",
        "at_ptr_type",
        "at_bbc_team",
        "at_custom1",
        "at_custom2",
        "at_custom3",
        "at_custom4"
      ],
      "source": "BBC",
      "notes": "AT Internet tags on shared articles. A blanket at_* prefix would be too broad for other sites."
    },
    {
      "sites": [
        "theguardian.com"
      ],
      "params": [
        "CMP",
        "INTCMP"
      ],
      "source": "The Guardian",
      "notes": "CMP=share_btn_link and friends record which share button was used."
    },
    {
      "sites": [
        "meetup.com"
      ],
      "params": [
        "recId",
        "recSource",
        "searchId",
        "eventOrigin",
        "_xtd"
      ],
      "source": "Meetup",
      "notes": "Recommendation and search tracking on event links."
    },
    {
      "sites": [
        "klook.com"
      ],
      "params": [
        "spm",
        "clickId"
      ],
      "source": "Klook",
      "notes": "Page tracking. aid (affiliate) is kept, see affiliateParams."
