<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_rounded"
        android:elevation="6dp"
        android:padding="28dp">

        <!--
            Colors are set programmatically in ShareActivity via setIndicatorColor(), not here,
            since this widget reads its colour array via a plain (non-theme-aware) lookup, so
            "?attr/..." references in an XML array resource silently resolve to nothing.
        -->
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/resolving_spinner"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/resolving_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/resolving_message"
            android:textColor="#1C1B1F"
            android:textSize="15sp"
            android:textAlignment="center"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
